# Generated local-only credentials: npm run env:init
POSTGRES_USER=rapidfire
POSTGRES_DB=rapidfire
POSTGRES_PASSWORD=GENERATE_LOCAL_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=GENERATE_LOCAL_DATABASE_URL
HOST=127.0.0.1
PORT=3000
WEB_PORT=5173
# Comma-separated exact browser origins. Defaults to local web origins.
GAME_ALLOWED_ORIGINS=
# Optional system Chromium; otherwise install Playwright's bundled Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Local secret is generated by env:init. Production needs its own secret and HTTPS URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Resend HTTPS API. Add the key securely; use a sender on a verified domain.
RESEND_API_KEY=
# For example: Rapidfire <no-reply@your-verified-domain.example>
EMAIL_FROM=
