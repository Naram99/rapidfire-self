    "magicResist": {
      "singularKey": "units.magicResist.singular",
      "pluralKey": "units.magicResist.plural"
    },
    "distance": {
      "singularKey": "units.distance.singular",
      "pluralKey": "units.distance.plural"
    },
    "hpPer5Seconds": {
      "singularKey": "units.hpPer5Seconds.singular",
      "pluralKey": "units.hpPer5Seconds.plural"
    },
    "manaPer5Seconds": {
      "singularKey": "units.manaPer5Seconds.singular",
      "pluralKey": "units.manaPer5Seconds.plural"
    },
    "attackDamage": {
      "singularKey": "units.attackDamage.singular",
      "pluralKey": "units.attackDamage.plural"
    },
    "attacksPerSecond": {
      "singularKey": "units.attacksPerSecond.singular",
      "pluralKey": "units.attacksPerSecond.plural"
    },
    "percentagePoints": {
      "singularKey": "units.percentagePoints.singular",
      "pluralKey": "units.percentagePoints.plural"
    },
    "skinCount": {
      "singularKey": "units.skinCount.singular",
      "pluralKey": "units.skinCount.plural"
    },
    "chromaCount": {
      "singularKey": "units.chromaCount.singular",
      "pluralKey": "units.chromaCount.plural"
    },
    "seconds": {
      "singularKey": "units.seconds.singular",
      "pluralKey": "units.seconds.plural"
    }
  },
  "operators": {
    "min": {
      "kind": "numeric",
      "solutionRule": "minimum",
      "answerMode": "single",
      "differenceReference": "correctOptionValue",
      "requireDistinctOptionValues": false
    },
    "max": {
      "kind": "numeric",
      "solutionRule": "maximum",
      "answerMode": "single",
      "differenceReference": "correctOptionValue",
      "requireDistinctOptionValues": false
    },
    "min2nd": {
      "kind": "numeric",
      "solutionRule": "secondMinimum",
      "answerMode": "single",
      "differenceReference": "correctOptionValue",
      "requireDistinctOptionValues": true
    },
    "max2nd": {
      "kind": "numeric",
      "solutionRule": "secondMaximum",
      "answerMode": "single",
      "differenceReference": "correctOptionValue",
      "requireDistinctOptionValues": true
    },
    "exactMatch": {
      "kind": "numeric",
      "solutionRule": "equalToVisibleValue",
      "answerMode": "single",
      "differenceReference": "visibleValue",
      "requireDistinctOptionValues": false
    },
    "lessThan": {
      "kind": "numeric",
      "solutionRule": "belowVisibleThreshold",
      "answerMode": "multiple",
      "differenceReference": "visibleThreshold",
      "requireDistinctOptionValues": false
    },
    "moreThan": {
      "kind": "numeric",
      "solutionRule": "aboveVisibleThreshold",
      "answerMode": "multiple",
      "differenceReference": "visibleThreshold",
      "requireDistinctOptionValues": false
    },
    "identify": {
      "kind": "lookup",
      "solutionRule": "clueOwner",
      "answerMode": "single"
    }
  },
  "difficultyProfiles": {
    "easy": {
      "nameKey": "difficulty.easy",
      "optionCount": 4,
      "allowedNumericOperatorIds": ["min", "max", "exactMatch"],
      "relativeDifference": {
        "minimum": 0.3
      },
      "requireDistinctOptionValues": false
    },
    "medium": {
      "nameKey": "difficulty.medium",
      "optionCount": 4,
      "allowedNumericOperatorIds": ["min", "max", "exactMatch"],
      "relativeDifference": {
        "minimum": 0.1,
        "maximum": 0.3
      },
      "requireDistinctOptionValues": false
    },
    "hard": {
      "nameKey": "difficulty.hard",
      "optionCount": 6,
      "allowedNumericOperatorIds": [
        "min",
        "max",
        "min2nd",
        "max2nd",
        "exactMatch"
      ],
      "relativeDifference": {
        "maximum": 0.1
      },
      "requireDistinctOptionValues": false
    },
    "challenger": {
      "nameKey": "difficulty.challenger",
      "optionCount": 6,
      "allowedNumericOperatorIds": [
        "min",
        "max",
        "min2nd",
        "max2nd",
        "exactMatch",
        "lessThan",
        "moreThan"
      ],
      "relativeDifference": {},
      "requireDistinctOptionValues": true
    }
  },
