{
  "schemaVersion": 1,
  "catalogId": "league-of-legends-text-mvp",
  "status": "draft",
  "topicId": "league-of-legends",
  "language": "en",
  "translationsFile": "texts.en.json",
  "supportedMedia": ["text"],
  "categoryIdPattern": "{{topicId}}:{{familyId}}:{{difficultyId}}",
  "categoryLabelKey": "category.variant",
  "rules": {
    "questionsPerCategory": 5,
    "numericPrecision": "exactSourceDecimal",
    "sourceValueRounding": "none",
    "zeroReferencePolicy": "exclude",
    "missingValuePolicy": "excludeSubject",
    "thresholdEqualityPolicy": "excludeSubject",
    "thresholdGrid": {
      "origin": 0,
      "minimumMultiplier": 1,
      "range": "subjectMinimumToMaximum"
    },
    "ambiguousLookupCluePolicy": "exclude",
    "singleAnswerCorrectCount": 1,
    "multipleAnswerMinimumCorrectCount": 1,
    "multipleAnswerMinimumIncorrectCount": 1,
    "questionIdentity": {
      "scope": "matchFamilyDifficulty",
      "fields": ["familyId", "metricId", "operatorId", "visibleParameters"],
      "crossDifficultyReuse": "differentSubjectSet",
      "minimumChangedSubjects": 1
    },
    "availability": {
      "invalidConfiguration": "rejectCatalog",
      "missingCapability": "excludeAffectedPairs",
      "insufficientOptions": "excludeAffectedPairs",
      "insufficientQuestions": "excludeCategoryVariant"
    }
  },
  "valueFormat": {
    "decimalSeparator": ".",
    "fractionDigits": "source",
    "trimTrailingZeros": true,
    "numberUnitSeparator": " "
  },
  "subjects": {
    "champions": {
      "keyFields": ["riotChampionKey"],
      "optionTemplateKey": "options.champion"
    },
    "skins": {
      "keyFields": ["riotChampionKey", "riotSkinId"],
      "optionTemplateKey": "options.skin"
    },
    "spells": {
      "keyFields": ["riotChampionKey", "spellSlot", "sourceSpellId"],
      "optionTemplateKey": "options.spell"
    }
  },
  "units": {
    "hp": {
      "singularKey": "units.hp.singular",
