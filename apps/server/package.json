{
  "name": "@rapidfire/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/bootstrap/index.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.browser.json",
    "build": "tsc --project tsconfig.build.json",
    "auth:generate": "auth generate --config ./auth.generate.ts --adapter drizzle --dialect postgresql --output ./src/database/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate-cli.ts",
    "admin:access": "tsx --env-file-if-exists=../../.env src/lol-data/admin-cli.ts",
    "lol:import-files": "tsx --env-file-if-exists=../../.env src/lol-data/import-files-cli.ts"
  },
  "dependencies": {
    "@rapidfire/contracts": "0.0.0",
    "@rapidfire/game-engine": "0.0.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "pg": "8.23.1",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
