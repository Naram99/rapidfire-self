          "name": "game_times",
          "value": "\"game\".\"start_countdown_ms\" > 0 AND \"game\".\"category_selection_ms\" > 0 AND \"game\".\"question_countdown_ms\" > 0 AND \"game\".\"evaluation_ms\" > 0 AND \"game\".\"final_results_ms\" > 0"
